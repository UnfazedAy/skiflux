        first_name:
          type: string
          minLength: 1
          maxLength: 255
        last_name:
          type: string
          default: ''
          maxLength: 255
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 8
        password_confirm:
          type: string
          writeOnly: true
          minLength: 8
        role_type:
          $ref: '#/components/schemas/CreateAdminUserRoleTypeEnum'
        role_id:
          type: string
          format: uuid
          nullable: true
      required:
      - email
      - first_name
      - password
      - password_confirm
      - role_type
    CreateAdminUserRoleTypeEnum:
      enum:
      - admin
