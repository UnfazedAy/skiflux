      description: '* `unpublish` - unpublish'
    AdminLoginRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - email
      - password
    AdminLogoutRequest:
      type: object
      properties:
        refresh_token:
          type: string
          minLength: 1
      required:
      - refresh_token
    AdminRefreshTokenRequest:
      type: object
      properties:
        refresh_token:
          type: string
          minLength: 1
      required:
      - refresh_token
    AppleSocialAuthRequest:
      type: object
      properties:
        identity_token:
          type: string
          minLength: 1
        first_name:
          type: string
          default: ''
        last_name:
          type: string
          default: ''
      required:
      - identity_token
    CompleteOnboardingRequest:
      type: object
      properties:
        username:
          type: string
          minLength: 1
        skillworld:
          $ref: '#/components/schemas/SkillworldEnum'
        goal:
          type: array
          items:
            $ref: '#/components/schemas/GoalEnum'
        avatar:
          type: string
          format: binary
          writeOnly: true
      required:
      - goal
      - skillworld
      - username
    CreateAdminUserRequest:
      type: object
