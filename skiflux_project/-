openapi: 3.0.3
info:
  title: SkiFlux API
  version: 1.0.0
  description: Backend API documentation and testing for SkiFlux
paths:
  /api/v1/admin/auth/login:
    post:
      operationId: v1_admin_auth_login_create
      description: Authenticate an admin user.Returns access and refresh tokens.
      summary: Admin Login
      tags:
      - Admin › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminLoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminLoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminLoginRequest'
        required: true
      security:
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Login successful.
  /api/v1/admin/auth/logout:
    post:
      operationId: v1_admin_auth_logout_create
      description: Blacklist the admin refresh token, ending the session.
      summary: Admin Logout
      tags:
      - Admin › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminLogoutRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminLogoutRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminLogoutRequest'
        required: true
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Logged out successfully.
  /api/v1/admin/auth/token/refresh:
    post:
      operationId: v1_admin_auth_token_refresh_create
      description: Exchange a valid admin refresh token for a new access token.
      summary: Admin Token Refresh
      tags:
      - Admin › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminRefreshTokenRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminRefreshTokenRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminRefreshTokenRequest'
        required: true
      security:
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Returns new access_token.
  /api/v1/admin/creators/:
    get:
      operationId: v1_admin_creators_list
      description: Admin endpoint to retrieve a paginatedlist of all creators on the
        platform.
      summary: List all Creators
      tags:
      - Admin › Creator Management
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CreatorList'
          description: ''
  /api/v1/admin/creators/{id}/override/:
    patch:
      operationId: v1_admin_creators_override_partial_update
      description: Admin endpoint to forcefully perform actions on a creator's episode
        (e.g., unpublish).
      summary: Override Creator Episode
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Creator Management
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedOverrideEpisodeRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedOverrideEpisodeRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedOverrideEpisodeRequestRequest'
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/admin/creators/{id}/oversight/:
    get:
      operationId: v1_admin_creators_oversight_retrieve
      description: Admin endpoint to fetch high-leveloversight data (like episode
        count) for a specific creator.
      summary: Get Creator Oversight
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Creator Management
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/CreatorOversightResponse'
          description: ''
  /api/v1/admin/permissions:
    get:
      operationId: v1_admin_permissions_retrieve
      description: Returns every known permission codename and its label. Use this
        to build the role-creation UI.
      summary: List Available Permissions
      tags:
      - Admin › Roles
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: List of permission objects.
  /api/v1/admin/roles:
    get:
      operationId: admin_roles_list
      description: Returns all custom roles defined in the admin portal.
      summary: List Roles
      tags:
      - Admin › Roles
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: List of roles.
  /api/v1/admin/roles/{role_id}:
    get:
      operationId: admin_roles_retrieve
      description: Retrieve a single role by ID.
      summary: Get Role
      parameters:
      - in: path
        name: role_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Roles
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Role details.
  /api/v1/admin/roles/{role_id}/delete:
    delete:
      operationId: v1_admin_roles_delete_destroy
      description: Super admin deletes a role. Fails if any admin user is currently
        assigned to it.
      summary: Delete Role
      parameters:
      - in: path
        name: role_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Roles
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Role deleted.
  /api/v1/admin/roles/{role_id}/update:
    patch:
      operationId: v1_admin_roles_update_partial_update
      description: Super admin updates a role's name, description, or permissions.
      summary: Update Role
      parameters:
      - in: path
        name: role_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Roles
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUpdateRoleRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUpdateRoleRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUpdateRoleRequest'
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Role updated.
  /api/v1/admin/roles/create:
    post:
      operationId: v1_admin_roles_create_create
      description: Super admin creates a new custom rolewith a set of permissions.
      summary: Create Role
      tags:
      - Admin › Roles
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateRoleRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CreateRoleRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreateRoleRequest'
        required: true
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '201':
          description: Role created.
  /api/v1/admin/users:
    get:
      operationId: admin_users_list
      description: Returns all admin portal users.
      summary: List Admin Users
      tags:
      - Admin › Users
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: List of admin users.
  /api/v1/admin/users/{admin_id}:
    get:
      operationId: admin_users_retrieve
      description: Retrieve an admin user by ID.
      summary: Get Admin User
      parameters:
      - in: path
        name: admin_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Users
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Admin user details.
  /api/v1/admin/users/{admin_id}/deactivate:
    delete:
      operationId: v1_admin_users_deactivate_destroy
      description: Super admin deactivates an admin portal user (soft delete).
      summary: Deactivate Admin User
      parameters:
      - in: path
        name: admin_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Users
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Admin user deactivated.
  /api/v1/admin/users/{admin_id}/update:
    patch:
      operationId: v1_admin_users_update_partial_update
      description: Super admin updates an admin user's details or role assignment.
      summary: Update Admin User
      parameters:
      - in: path
        name: admin_id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - Admin › Users
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedUpdateAdminUserRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedUpdateAdminUserRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedUpdateAdminUserRequest'
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Admin user updated.
  /api/v1/admin/users/create:
    post:
      operationId: v1_admin_users_create_create
      description: Super admin creates a new adminportal user and assigns a role.
      summary: Create Admin User
      tags:
      - Admin › Users
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateAdminUserRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CreateAdminUserRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreateAdminUserRequest'
        required: true
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '201':
          description: Admin user created.
  /api/v1/auth/forgot-password:
    post:
      operationId: v1_auth_forgot_password_create
      description: send otp to user email
      summary: Forgot Password
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ForgotPasswordRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ForgotPasswordRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ForgotPasswordRequestRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Sends a reset code to user email if the email exists.
  /api/v1/auth/login:
    post:
      operationId: v1_auth_login_create
      description: Login a registered user.
      summary: Login
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LoginRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LoginRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Returns access_token and refresh_token
  /api/v1/auth/logout:
    post:
      operationId: v1_auth_logout_create
      description: Logs the user out by blacklisting their refresh token.
      summary: Logout
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/LogoutRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: Logged out successfully.
  /api/v1/auth/resend-register-otp:
    post:
      operationId: v1_auth_resend_register_otp_create
      description: Resends the OTP to the user's email.
      summary: Resend Verification OTP
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ResendOTPRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ResendOTPRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ResendOTPRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: A new verification code has been sent.
  /api/v1/auth/reset-password:
    post:
      operationId: v1_auth_reset_password_create
      description: verify otp and reset password
      summary: Reset Password
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ResetPasswordConfirmRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ResetPasswordConfirmRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ResetPasswordConfirmRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Password has been reset successfully.
  /api/v1/auth/signup:
    post:
      operationId: v1_auth_signup_create
      description: Registers a new user account**Note:** Passwords must be 8+ charactersand
        include uppercase, numbers, and symbols..
      summary: Register a new user
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SignupRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SignupRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SignupRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '201':
          description: Account created successfully
  /api/v1/auth/social/apple/init:
    get:
      operationId: v1_auth_social_apple_init_retrieve
      description: Returns a redirect to Apple's OAuth consent page.
      summary: Initiate Apple Login
      tags:
      - User › Social Auth
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '302':
          description: Redirects to Apple consent page.
  /api/v1/auth/social/google/callback:
    get:
      operationId: v1_auth_social_google_callback_retrieve
      description: Google redirects here after the user consents. This exchanges the
        code, logs in/creates the user, and redirects to the frontend with tokens.
      summary: Google OAuth Callback
      tags:
      - User › Social Auth
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '302':
          description: Redirects to frontend with tokens.
  /api/v1/auth/social/google/init:
    get:
      operationId: v1_auth_social_google_init_retrieve
      description: Returns a redirect to Google's OAuth consent page. The frontend
        should open this URL in a browser or WebView.
      summary: Initiate Google Login
      tags:
      - User › Social Auth
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '302':
          description: Redirects to Google consent page.
  /api/v1/auth/social/mobile/apple:
    post:
      operationId: v1_auth_social_mobile_apple_create
      description: Authenticate with an Apple Identity Token from Sign in with Apple.
      summary: Apple Social Login For mobile
      tags:
      - User › Social Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AppleSocialAuthRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AppleSocialAuthRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AppleSocialAuthRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Returns access_token and refresh_token.
  /api/v1/auth/social/mobile/google:
    post:
      operationId: v1_auth_social_mobile_google_create
      description: Authenticate with a Google ID Token from Google Sign-In. Returns
        access and refresh tokens.
      summary: Google Social Login For mobile
      tags:
      - User › Social Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GoogleSocialAuthRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/GoogleSocialAuthRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/GoogleSocialAuthRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Returns access_token and refresh_token.
  /api/v1/auth/token/refresh:
    post:
      operationId: v1_auth_token_refresh_create
      description: Exchanges a valid refresh token for a new access token.
      summary: Refresh Access Token
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RefreshTokenRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Returns access_token.
  /api/v1/auth/verify-forgot-password-otp:
    post:
      operationId: v1_auth_verify_forgot_password_otp_create
      description: Verifies the 6-digit OTP sent during forgot password.
      summary: Verify email OTP
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyForgotPasswordCodeRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/VerifyForgotPasswordCodeRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyForgotPasswordCodeRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Password OTP verified successfully.
  /api/v1/auth/verify-register-email:
    post:
      operationId: v1_auth_verify_register_email_create
      description: Verifies the user's email using the 6-digit OTP sent during signup.
      summary: Verify Email
      tags:
      - User › Auth
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
        required: true
      security:
      - bearerAuth: []
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Email verified successfully. You can now login.
  /api/v1/creator/create-episode:
    post:
      operationId: v1_creator_create_episode_create
      summary: Upload Video Episode
      tags:
      - Admin › Studio Content
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/EpisodeCreateRequest'
        required: true
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/creator/create-season:
    post:
      operationId: v1_creator_create_season_create
      summary: Create a Season
      tags:
      - Admin › Studio Content
      requestBody:
        content:
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SeasonCreateRequest'
        required: true
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/creator/list-episodes:
    get:
      operationId: v1_creator_list_episodes_retrieve
      summary: List My Episodes
      tags:
      - Admin › Studio Content
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/creator/list-seasons:
    get:
      operationId: v1_creator_list_seasons_retrieve
      summary: List My Seasons
      tags:
      - Admin › Studio Content
      security:
      - adminBearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          description: No response body
  /api/v1/creator/register:
    post:
      operationId: v1_creator_register_create
      summary: Register Creator Account
      tags:
      - Admin › Creator Profile
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreatorRegistrationRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CreatorRegistrationRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreatorRegistrationRequest'
        required: true
      security:
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
  /api/v1/creator/resend-otp:
    post:
      operationId: v1_creator_resend_otp_create
      description: Resends the 6-digit OTP to the Creator's email address.
      summary: Resend OTP to Creator Email
      tags:
      - Admin › Creator Profile
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreatorResendOTPRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/CreatorResendOTPRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/CreatorResendOTPRequest'
        required: true
      security:
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: OTP sent successfully.
  /api/v1/creator/verify-email:
    post:
      operationId: v1_creator_verify_email_create
      description: Verifies the Creator's email using the 6-digit OTP sent during
        signup.
      summary: Verify Creator Email
      tags:
      - Admin › Creator Profile
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyEmailRequest'
        required: true
      security:
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: Creator Email verified successfully. You can now login.
  /api/v1/episodes/{id}/comments:
    get:
      operationId: v1_episodes_comments_list
      description: Retrieves all comments for a given episode.
      summary: Get Episode Comments
      parameters:
      - in: path
        name: id
        schema:
          type: string
          format: uuid
        required: true
      tags:
      - User › Content Interactions
      security:
      - bearerAuth: []
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/EpisodeComment'
          description: ''
  /api/v1/episodes/comment:
    post:
      operationId: v1_episodes_comment_create
      description: Adds a comment to a specific episode.
      summary: Add Comment to Episode
      tags:
      - User › Content Interactions
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/EpisodeCommentCreateRequest'
          application/x-www-form-urlencoded:
            schema:
