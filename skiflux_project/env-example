# MinIO (S3-compatible) - used for durable cross-container temp file handoff (web -> workers)
# Required for episode video uploads, reuploads, creator avatars, user onboarding avatars.
# Point to your MinIO server (e.g. DigitalOcean droplet or local MinIO).
# Note at the moment it's not really minio but cloudflare r2.
# Minio keywords are just used for compatibility with the code from previous implementation.
MINIO_ENDPOINT_URL=https://storage.mandell.tech
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=skiflux-uploads

# Push Notifications (FCM legacy server key)
# Required to actually deliver push notifications to iOS/Android/Web devices.
#
# HOW TO OBTAIN:
# 1. https://console.firebase.google.com/ → select/create project.
# 2. Project settings (gear) → Cloud Messaging tab.
# 3. If "Cloud Messaging API (Legacy)" shows "..." menu:
#    Click "..." → "Manage API in Google Cloud Console" → Enable the API.
# 4. Refresh the tab in Firebase Console.
# 5. Copy the "Server key" value under Cloud Messaging API (Legacy).
#
# Also register your app (Android package name + iOS bundle ID) in the same Firebase project
# and include the config files in the mobile client.
#
# Note: This is the simple legacy key. For new projects prefer HTTP v1 + service account
# (we can upgrade the sender later; google-auth is already a dependency).
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

